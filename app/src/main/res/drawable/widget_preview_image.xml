<?xml version="1.0" encoding="utf-8"?>
<!-- Generic picker preview for launchers that ignore previewLayout (API < 31). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="180dp" android:height="110dp">
        <shape android:shape="rectangle">
            <solid android:color="#FF1B3A5C" />
            <corners android:radius="16dp" />
        </shape>
    </item>
    <item android:width="48dp" android:height="48dp" android:gravity="center"
        android:drawable="@drawable/widget_preview_glyph" />
</layer-list>
