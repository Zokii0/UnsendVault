<?xml version="1.0" encoding="utf-8"?>
<!-- The only network use is the opt-in update check (HTTPS to api.github.com). No cleartext, no user-added CAs. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
